Windows Registry Editor Version 5.00

[-HKEY_CLASSES_ROOT\*\shell\TakeOwnership]
[-HKEY_CLASSES_ROOT\Directory\shell\TakeOwnership]
[-HKEY_CLASSES_ROOT\Drive\shell\TakeOwnership]
[-HKEY_CLASSES_ROOT\Directory\Background\shell\TakeOwnership]

[HKEY_CLASSES_ROOT\*\shell\TakeOwnership]
@="Take Ownership"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Position"="middle"

[HKEY_CLASSES_ROOT\*\shell\TakeOwnership\command]
@="powershell -windowstyle hidden -command \"Start-Process cmd -ArgumentList '/c takeown /f \\\"%1\\\" /a && icacls \\\"%1\\\" /remove \"NT SERVICE\\TrustedInstaller\" /grant administrators:F /grant system:F /grant Users:F /c /l' -Verb runAs\""
"IsolatedCommand"="powershell -windowstyle hidden -command \"Start-Process cmd -ArgumentList '/c takeown /f \\\"%1\\\" /a && icacls \\\"%1\\\" /remove \"NT SERVICE\\TrustedInstaller\" /grant administrators:F /grant system:F /grant Users:F /c /l' -Verb runAs\""

[HKEY_CLASSES_ROOT\Directory\shell\TakeOwnership]
@="Take Ownership"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Position"="middle"
"AppliesTo"="NOT (System.ItemPathDisplay:=\"C:\\Windows\" OR System.ItemPathDisplay:=\"C:\\Program Files\" OR System.ItemPathDisplay:=\"C:\\Program Files (x86)\" OR System.ItemPathDisplay:=\"C:\\Users\" OR System.ItemPathDisplay:=\"C:\\ProgramData\")"

[HKEY_CLASSES_ROOT\Directory\shell\TakeOwnership\command]
@="powershell -windowstyle hidden -command \"Start-Process cmd -ArgumentList '/c takeown /f \\\"%1\\\" /a /r /d y && icacls \\\"%1\\\" /remove \"NT SERVICE\\TrustedInstaller\" /grant administrators:F /grant system:F /grant Users:F /t /c /l /q' -Verb runAs\""
"IsolatedCommand"="powershell -windowstyle hidden -command \"Start-Process cmd -ArgumentList '/c takeown /f \\\"%1\\\" /a /r /d y && icacls \\\"%1\\\" /remove \"NT SERVICE\\TrustedInstaller\" /grant administrators:F /grant system:F /grant Users:F /t /c /l /q' -Verb runAs\""

[HKEY_CLASSES_ROOT\Drive\shell\TakeOwnership]
@="Take Ownership"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Position"="middle"
"AppliesTo"="NOT (System.ItemPathDisplay:=\"C:\\\")"

[HKEY_CLASSES_ROOT\Drive\shell\TrustOwnership\command]
[HKEY_CLASSES_ROOT\Drive\shell\TakeOwnership\command]
@="cmd.exe /c takeown /f \"%1\\\" /a /r /d y && icacls \"%1\\\" /remove \"NT SERVICE\\TrustedInstaller\" /grant administrators:F /grant system:F /grant Users:F /t /c"
"IsolatedCommand"="cmd.exe /c takeown /f \"%1\\\" /a /r /d y && icacls \"%1\\\" /remove \"NT SERVICE\\TrustedInstaller\" /grant administrators:F /grant system:F /grant Users:F /t /c"

[HKEY_CLASSES_ROOT\Directory\Background\shell\TakeOwnership]
@="Take Ownership (This Folder)"
"HasLUAShield"=""
"Position"="middle"

[HKEY_CLASSES_ROOT\Directory\Background\shell\TakeOwnership\command]
@="cmd.exe /c takeown /f \"%V\" /a /r /d y && icacls \"%V\" /remove \"NT SERVICE\\TrustedInstaller\" /grant administrators:F /grant system:F /grant Users:F /t /c"
